{
  "name": "kuwait-curriculum-kb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/src/cli.js serve",
    "kb": "tsx src/cli.ts",
    "download:moe-highschool": "node scripts/download-moe-highschool.mjs",
    "inventory:moe-highschool": "node scripts/download-moe-highschool.mjs --inventory-only",
    "import:moe-highschool": "tsx scripts/import-moe-highschool.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@napi-rs/canvas": "0.1.88",
    "ipaddr.js": "2.2.0",
    "pdfjs-dist": "4.8.69",
    "pg": "8.16.3",
    "sharp": "0.35.4",
    "undici": "7.29.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.15.5",
    "pdf-lib": "1.17.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
