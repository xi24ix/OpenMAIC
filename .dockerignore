# dependencies
node_modules
.pnpm-store

# build output
.next
out
build
dist

# git
.git
.gitignore

# IDE
.idea
.vscode

# env & secrets
.env*
!.env.example
server-providers*.yml
# The model configuration is deployment-owned and stays in the repo, but its
# secrets come from the environment (${OPENROUTER_API_KEY} etc. are
# interpolated at boot), so baking the file is safe: no keys in the image.
# A run-time bind mount of /app/openmaic.yml overrides the baked-in copy.
!openmaic.yml

# misc
assets
*.md
*.pdf
*.pem
.DS_Store
.vercel
coverage
logs
data
docs
.claude

# local data-prep workspaces — the knowledge base is a separate project,
# built and served elsewhere (kwdb.zobeidi.com); never part of the app image.
knowledge-base-curiculum
books
book-lessons

# isolated MP4 render service — built as its own image (render-service/Dockerfile),
# never part of the main app image.
render-service
